{
  "_comment": "Example project for the mb-opc OPC UA bridge. This is the same JSON the mbSCADA desktop app saves. Edit host/port, then run:  mb-opc --project example-project.json --listen 0.0.0.0:4840",
  "connections": [
    {
      "id": "c1",
      "name": "Reactor PLC",
      "kind": "tcp",
      "host": "127.0.0.1",
      "port": 1502,
      "timeout_ms": 1000,
      "slave": 1
    }
  ],
  "polls": [
    {
      "id": 1,
      "name": "Temps",
      "conn_id": "c1",
      "slave": 1,
      "func": 3,
      "start": 0,
      "qty": 2,
      "scan_ms": 1000,
      "fmt": "f32_abcd",
      "mult": 1.0,
      "div": 1.0,
      "unit": "°C",
      "labels": { "0": "T reactor" },
      "alarms": {
        "0": { "hihi": 90.0, "hi": 80.0, "lo": 5.0, "msg_hihi": "T2 JACKET OVERHEAT" }
      }
    },
    {
      "id": 2,
      "name": "Pressures",
      "conn_id": "c1",
      "slave": 1,
      "func": 3,
      "start": 2,
      "qty": 2,
      "scan_ms": 1000,
      "fmt": "f32_abcd",
      "mult": 0.1,
      "div": 1.0,
      "unit": "bar",
      "labels": { "2": "P inlet" }
    },
    {
      "id": 3,
      "name": "Counter",
      "conn_id": "c1",
      "slave": 1,
      "func": 3,
      "start": 20,
      "qty": 2,
      "scan_ms": 1000,
      "fmt": "u32",
      "labels": { "20": "N batches" }
    },
    {
      "id": 4,
      "name": "Valves",
      "conn_id": "c1",
      "slave": 1,
      "func": 1,
      "start": 0,
      "qty": 10,
      "scan_ms": 1000,
      "fmt": "u16",
      "labels": { "5": "V5 open" }
    }
  ],
  "computed": [
    { "name": "T-P index", "expr": "{T reactor} / max({P inlet}, 0.001)", "unit": "", "decimals": 2 }
  ]
}
