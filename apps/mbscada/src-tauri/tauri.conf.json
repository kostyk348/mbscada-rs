{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mbSCADA",
  "version": "1.8.0",
  "identifier": "com.kostyk.mbscada",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mbSCADA — Modbus Poll + SCADA",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kostyk348/mbscada-rs/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDMDY0RjNBQjRFMzE1QkIKUldTN0ZlTzBPazhHREhiQ3orOWxTU0M1WHZDVGpBODdmQ0FvNHJDWG13OTFUUmFDcmw4UFRTenEK"
    }
  }
}
